# Python
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境（含本机绝对路径，不要提交）
.venv/
venv/
env/

# 运行时临时目录（env_fix 重定向的工作目录）
work/

# PyInstaller 构建产物
build/work/
*.log
dist/
release/
*.spec.bak

# 环境变量（可能包含 API keys / 密钥）
.env
.env.*

# 密钥文件
*.key
*.pem
*.p12
*.pfx

# 配置文件（可能包含敏感配置项）
config.json
config.yaml
config.yml
config.toml

# 敏感信息文件
secrets.*
credentials.*

# 本地/编辑器
.vscode/
.idea/
.DS_Store